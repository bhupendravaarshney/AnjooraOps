# App
NODE_ENV=production
# Keep false during provisioning. Set true only for the final release gate.
GO_LIVE=false
# Immutable build/version identifier; required and evidence-matched when GO_LIVE=true.
RELEASE_CANDIDATE=
# Final gate inputs (keep real staff/evidence files outside source control).
# STAFF_REGISTER_FILE=/secure/path/production-staff-register.json
# RELEASE_EVIDENCE_FILE=/secure/path/release-evidence.json
# STAFF_OPERATOR and STAFF_RECOVERY_APPROVAL_REF are supplied only to staff-management commands.
NEXT_PUBLIC_APP_URL=https://your-domain.com
APP_URL=https://your-domain.com
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@anjoora.in
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ENABLE_DEMO_FORM=false
ANJOORA_INTEGRATION_SECRET=replace-with-a-separate-long-random-secret

# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-random-local-database-password
DATABASE_URL=postgresql://anjoora:replace-with-the-same-url-encoded-password@postgres:5432/anjoora
# Local Compose uses false. Every non-local production deployment must use true.
DATABASE_SSL=false
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Business-approved recovery objectives; required when GO_LIVE=true.
BACKUP_RPO_HOURS=
BACKUP_RTO_MINUTES=

# Payment provider adapter / webhook
PAYMENT_PROVIDER=EXTERNAL
PAYMENT_LINK_BASE_URL=https://payments.example.test/checkout
PAYMENT_WEBHOOK_SECRET=replace-with-a-payment-webhook-signing-secret
# Version/name of the reviewed normalizer that verifies the provider webhook and signs the canonical adapter payload.
PAYMENT_ADAPTER_ID=
# Map the provider's real event names to PENDING, PAID, FAILED, CANCELLED, and REFUNDED.
PAYMENT_EVENT_MAP={}

# WhatsApp handoff (number owned by ANJOORA, digits only with country code)
ANJOORA_WHATSAPP_NUMBER=919999999999
WHATSAPP_FOLIO_MODE=full

# Meta WhatsApp Cloud API - optional as one complete group until bot is connected
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_HTTP_TIMEOUT_MS=10000
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_DISPATCH=
WHATSAPP_TEMPLATE_DELIVERED=
WHATSAPP_TEMPLATE_REFILL=

# Required protected job endpoints (outbox every minute; refill/maintenance daily)
CRON_SECRET=replace-with-another-long-random-secret

# Refill defaults
REFILL_REMINDER_DAYS_BEFORE=4

# Retention / maintenance defaults
CONSULTATION_CONSENT_VERSION=
CONSULTATION_CONSENT_TEXT=
PRIVACY_IDENTITY_VERIFICATION_METHOD=
PRIVACY_APPROVAL_ID=
PRIVACY_APPROVED_AT=
CONSULTATION_RAW_PAYLOAD_DAYS=30
WHATSAPP_RAW_PAYLOAD_DAYS=30
WHATSAPP_MESSAGE_BODY_DAYS=365
PAYMENT_RAW_PAYLOAD_DAYS=30
RATE_LIMIT_EVENT_DAYS=2
OUTBOX_RETENTION_DAYS=365
JOB_RUN_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=2555
CUSTOMER_RECORD_RETENTION_DAYS=2555
